rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────────

    /// Returns true when the request is coming from a signed-in user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true when the signed-in UID matches the given uid.
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Document path: users/{uid}
    // Only the owner can read/write their own profile.
    // The auth system creates the document on registration — uid must match.

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      allow delete: if isUser(uid);
    }

    // ─── Rides ────────────────────────────────────────────────────────────────
    // Document path: rides/{rideId}
    // - Any authenticated user can read (find/search rides).
    // - A signed-in user can create a ride where driverId == their UID.
    // - Only the creator (driverId) can update or delete their own ride.

    match /rides/{rideId} {
      allow read: if isAuthenticated();

      // Create: the document being written must have driverId == the requester's UID.
      // This prevents a user from creating a ride on behalf of another user.
      allow create: if isAuthenticated()
                    && request.resource.data.driverId == request.auth.uid;

      // Update: only the ride creator may modify the document.
      allow update: if isAuthenticated()
                    && resource.data.driverId == request.auth.uid;

      // Delete: only the ride creator may permanently delete the document.
      allow delete: if isAuthenticated()
                    && resource.data.driverId == request.auth.uid;
    }

    // ─── Ride Requests ────────────────────────────────────────────────────────
    // Document path: rideRequests/{requestId}
    // Fields: requesterUid, ownerUid, rideId, status, ...
    //
    // READ is allowed for any authenticated user so that:
    //   a) The driver can query requests for their ride (WHERE rideId == x).
    //   b) deleteRide() can batch-delete associated requests.
    //   c) The passenger can check their own existing request.
    // Firestore query rules cannot filter on per-document fields, so a broader
    // read permission is required for collection-level queries to succeed.
    //
    // WRITE rules remain strict: only the requester can create, and only the
    // owner or requester may update or delete.

    match /rideRequests/{requestId} {
      // Any authenticated user can read (enables collection queries by rideId, ownerUid, requesterUid)
      allow read: if isAuthenticated();

      // Only the passenger (requester) can create a request for themselves
      allow create: if isAuthenticated()
                    && request.resource.data.requesterUid == request.auth.uid;

      // Ride owner can accept/reject; requester can cancel their own request
      allow update: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.requesterUid == request.auth.uid);

      // Ride owner or requester can delete (used by deleteRide batch cleanup)
      allow delete: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.requesterUid == request.auth.uid);
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Document path: notifications/{notificationId}
    // Field: userId = the recipient's UID.
    //
    // - A user can only read/update/delete their own notifications.
    // - Any authenticated user can create a notification (server-side delivery).
    //   In production you'd restrict creates to Cloud Functions only.

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated();

      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ─── Chats ────────────────────────────────────────────────────────────────
    // Document path: chats/{chatId}
    // A chat belongs to two participants; both can read and write.

    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Messages ─────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Ratings ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated()
                            && resource.data.reviewerId == request.auth.uid;
    }

    // ─── Vehicles ─────────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─── Feedback & Reports ───────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Immutable once submitted
    }

    match /reports/{reportId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── App Config ───────────────────────────────────────────────────────────
    // Read-only configuration data — no one can write from the client.
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Driver Directory ─────────────────────────────────────────────────────
    match /driver_directory/{driverId} {
      allow read, write: if isAuthenticated();
    }
  }
}
